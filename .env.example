DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/filestorage

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=filestorage

SECRET_KEY=change-me-in-production
